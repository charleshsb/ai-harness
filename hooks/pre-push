#!/usr/bin/env bash
# Pre-push: refuse any push that updates main or master on the remote (force pushes included).
# Git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
# Install with: adapters/claude/install.sh --git-hooks <repo>, or symlink it into <repo>/.git/hooks/.
set -u

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "Push blocked: it would update '${remote_ref#refs/heads/}' directly." >&2
      blocked=1
      ;;
  esac
done

if [ "$blocked" -eq 1 ]; then
  echo "Push your branch and open a pull request instead:" >&2
  echo "  git push -u origin HEAD" >&2
  echo "Emergency only, with the owner's explicit approval: git push --no-verify" >&2
  exit 1
fi
exit 0
